{
  "name": "updates-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "local-server": "tsx scripts/local-server.ts",
    "publish:pr": "tsx scripts/publish-update.ts",
    "synth": "cdk synth --app 'tsx bin/updates-server.ts'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/client-ssm": "^3.883.0",
    "aws-cdk-lib": "^2.215.0",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.152",
    "@types/node": "^22.18.1",
    "aws-cdk": "^2.1029.2",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
