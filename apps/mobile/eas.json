{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_UPDATES_CHANNEL": "staging"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_UPDATES_CHANNEL": "production"
      }
    }
  }
}
