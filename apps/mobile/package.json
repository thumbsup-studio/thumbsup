{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "bootstrap": "node ./scripts/setup.mjs",
    "build:graph": "node ./scripts/build-graph.mjs",
    "dev": "expo start --dev-client",
    "dev:install": "node ./scripts/dev-install.mjs",
    "diagnose": "node ./scripts/doctor.mjs",
    "preexport": "pnpm build:graph",
    "export": "expo export --platform all --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run && jest --runInBand",
    "prebuild:check": "node ./scripts/prebuild-check.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@thumbsup/api": "workspace:*",
    "@thumbsup/core": "workspace:*",
    "@thumbsup/tokens": "workspace:*",
    "expo": "57.0.20",
    "expo-asset": "~57.0.16",
    "expo-constants": "57.0.17",
    "expo-dev-client": "57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "57.0.3",
    "expo-linking": "57.0.9",
    "expo-router": "57.0.19",
    "expo-secure-store": "57.0.3",
    "expo-splash-screen": "57.0.8",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.3",
    "expo-updates": "57.0.21",
    "nativewind": "4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "0.2.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.1",
    "@types/react": "19.2.4",
    "babel-preset-expo": "57.0.10",
    "force-graph": "1.51.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "vite": "7.1.5",
    "vite-plugin-singlefile": "2.3.0",
    "vitest": "3.2.4"
  }
