# 로컬 개발용 환경변수
#
# 사용법: 이 파일을 .env.local로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env.local
# .env.local은 gitignore 대상이라 커밋되지 않는다. 이 예시 파일에는 절대 실제 키를 넣지 말 것.

# --- API 베이스 URL ---
# 미설정 시 코드 기본값은 prod API(https://thumbsup-api.duckdns.org) — 배포(Vercel)는 그대로 두면 된다.
# 로컬 개발에서 API를 붙이려면 로컬 서버(:8080)를 띄우고 아래를 설정한다
# (로컬 FE→prod 직접 호출은 CORS로 차단됨).
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- AI 시각 QA(visual-qa) 로컬 실행용 ---
# 키가 없어도 visual-qa는 동작한다 — 스크린샷만 저장하고 AI 리뷰는 건너뛴다(soft skip).
# PR 자동 리뷰는 GitHub Secret(ELICE_API_KEY·ELICE_QA_BASE_URL)로 CI에서 수행되므로,
# 로컬에서 리뷰까지 돌리며 빠르게 반복하고 싶은 경우에만 이 설정이 필요하다.

# 엘리스AX API 키 (팀 리드에게 요청 — 3개 발급 모델 공용)
ELICE_API_KEY=your-elice-api-key

# 시각 QA는 Gemini 3.1 Pro 사용 (팀 모델 운용 계획 — 스펙 §8 참고)
# 엔드포인트·모델 ID 모두 모델 라이브러리의 Gemini 3.1 Pro 페이지에서 복사.
# 엔드포인트는 반드시 /v1까지만 (뒤의 /chat/completions는 스크립트가 붙임).
ELICE_QA_BASE_URL=https://mlapi.run/your-model-endpoint-id/v1
ELICE_QA_MODEL=google/gemini-3.1-pro-preview
