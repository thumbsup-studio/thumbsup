# AI 시각 QA(visual-qa) 로컬 실행용 환경변수
#
# 사용법: 이 파일을 .env.local로 복사한 뒤 실제 값을 채운다.
#   cp .env.example .env.local
# .env.local은 gitignore 대상이라 커밋되지 않는다. 이 예시 파일에는 절대 실제 키를 넣지 말 것.
#
# 키가 없어도 visual-qa는 동작한다 — 스크린샷만 저장하고 AI 리뷰는 건너뛴다(soft skip).
# PR 자동 리뷰는 GitHub Secret(ELICE_API_KEY)·Variable(ELICE_BASE_URL)로 CI에서 수행되므로,
# 로컬에서 리뷰까지 돌리며 빠르게 반복하고 싶은 경우에만 이 설정이 필요하다.

# 엘리스AX API 키 (팀 리드에게 요청)
ELICE_API_KEY=your-elice-api-key

# 엘리스 OpenAI 호환 엔드포인트 — 반드시 /v1까지 포함
ELICE_BASE_URL=https://your-elice-endpoint.example.com/v1

# (선택) 리뷰에 사용할 멀티모달 모델 — 미설정 시 gpt-5.2
# ELICE_QA_MODEL=gpt-5.2
