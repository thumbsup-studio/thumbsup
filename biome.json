{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "apps/web/src/**",
      "apps/web/e2e/**",
      "apps/web/*.ts",
      "apps/web/*.tsx",
      "apps/web/*.json",
      "apps/web/*.mjs",
      "apps/web/scripts/**",
      "apps/mobile/src/**",
      "apps/mobile/*.ts",
      "apps/mobile/*.tsx",
      "apps/mobile/*.json",
      "apps/mobile/*.js",
      "apps/mobile/*.mjs",
      "apps/mobile/scripts/**",
      "apps/authoring/src/**",
      "apps/authoring/*.ts",
      "apps/authoring/*.json",
      "apps/authoring/*.mjs",
      "apps/authoring/scripts/**",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "packages/**/*.json"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" },
    "domains": { "next": "recommended", "react": "recommended" }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
